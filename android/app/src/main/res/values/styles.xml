<resources>

    <!-- 父 theme 由 react-native-edge-to-edge 提供，启用 Android edge-to-edge 模式
         （status / nav bar 透明、content 延伸到屏幕边缘，符合 Android 15+ 强制要求）。
         配合 react-native-keyboard-controller 一起处理 IME insets。 -->
    <style name="AppTheme" parent="Theme.EdgeToEdge">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- 关掉系统给三键导航栏加的对比度 scrim（默认 true）。开着时系统会在透明导航栏后面
             刷一层半透明保护底（浅色模式≈白、华为还带圆角），跟内容割裂成一条白带。关掉后导航栏
             真正透明，App 自己铺到屏底的内容（聊天页底部渐变等）透过去显示，跟其它 app 一致。
             导航栏本身（三个按钮 / 手势条）系统强制保留、删不掉，这里只是让它背景透明。 -->
        <item name="enforceNavigationBarContrast">false</item>
    </style>

</resources>
