# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported

# Build React Native Core from source (default). The prebuilt (release) rncore tarball omits the
# RN_DEBUG_STRING_CONVERTIBLE symbols (Sealable/ShadowNode::getDebugName/DebugStringConvertible…)
# that Debug-built Fabric component pods reference → "Undefined symbols for architecture arm64" at
# link. Building core from source in Debug keeps those symbols consistent. Set the env to '1'
# explicitly (e.g. CI/Release) to opt back into the prebuilt tarball.
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FlopsMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # In-app native module for FlowDocInput（Fabric atomic-pill rich text input）
  pod 'FlowDocInput', :path => './FlowDocInput'

  # iosMath：行内 LaTeX 公式渲染（FlowDocInput 的 EquationAttachment 依赖）
  pod 'iosMath'

  # In-app native Fabric view: iOS-only bouncy press-feedback button (UI-thread driven)
  pod 'BouncyButton', :path => './BouncyButton'

  # In-app native Fabric view: iOS UISegmentedControl wrapper (iOS 26+ auto Liquid Glass)
  pod 'BouncySegmentedControl', :path => './BouncySegmentedControl'

  # In-app native Fabric view: 独立 UITabBar wrapper（iOS 26+ floating pill + icon/title stacked）
  pod 'BouncyTabBar', :path => './BouncyTabBar'

  # In-app native Fabric view: 通用 Liquid Glass card 容器（UIVisualEffectView + UIGlassEffect）
  pod 'BouncyGlassCard', :path => './BouncyGlassCard'

  # In-app native Fabric view: 全屏 Applet 右上角胶囊（CALayer 绘制的三圆点 | 圆环，两半可点）
  pod 'AppletCapsule', :path => './AppletCapsule'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode's Swift "explicit modules" can't resolve some CocoaPods C/Clang modules (e.g. `argon2`
    # in RNArgon2 → "Unable to find module dependency: 'argon2'"). Disable explicit modules across
    # pod targets so those C modules resolve via header search paths as before.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |cfg|
        cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end
    end
    installer.pods_project.build_configurations.each do |cfg|
      cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
    end

    # Same setting on the app target (its bridging-header PCH also uses explicit modules).
    installer.aggregate_targets.each do |agg|
      next unless agg.user_project
      agg.user_project.native_targets.each do |target|
        target.build_configurations.each do |cfg|
          cfg.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
        end
      end
      agg.user_project.save
    end
  end
end
